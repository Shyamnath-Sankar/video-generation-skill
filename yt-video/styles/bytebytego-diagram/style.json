  "inspired_by": "clean system-design diagrams: white canvas, pastel boxes with coloured headers, numbered arrows, step-by-step reveals",
  "colors": {
    "bg": "#FFFFFF",
    "bg2": "#F5F7FB",
    "ink": "#1F2937",
